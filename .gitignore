# Whitelist: ignore everything, then list what is tracked.  eh/ is tracked in
# full; a NEW file under local/ is ignored until it gets a "!" line here.
*
*.*

!.gitignore
!init.el
!early-init.el
!LICENSE
!README.md
!eh/
# Track all of eh/ (personal modules); only skip editor and compile leftovers.
!eh/**
eh/**/*~
eh/**/*.elc
!local/
local/*
!local/cursor-chg.el
!local/org-pretty-table.el
!local/space-doc.el
