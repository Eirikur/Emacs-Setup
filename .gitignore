# Whitelist: ignore everything, then list what is tracked.  A NEW file under
# eh/ or local/ is ignored until it gets a "!" line here (or git add -f).
*
*.*

!.gitignore
!init.el
!early-init.el
!LICENSE
!README.md
!eh/
eh/*
!eh/eh-claude-follow.el
!eh/eh-cursor.el
!eh/eh-mode-line.el
!eh/python-icon.png
!eh/emacs-icon.png
!eh/wps-face-mode.el
!eh/eh-today.el
!local/
local/*
!local/cursor-chg.el
